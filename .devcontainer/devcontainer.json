{
  "name": "CSB Exhibit Submissions Dev Container",
  "runArgs": ["--name", "csb-exhibit-submissions-devcontainer"],
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "alternativeVersions": "9.0",
      "dotnetRuntimeVersions": "10.0",
      "aspnetcoreRuntimeVersions": "10.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-from-docker:1.6.5": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot-chat",
        "esbenp.prettier-vscode",
        "vue.volar",
        "christian-kohler.path-intellisense",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "sonarsource.sonarlint-vscode",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker",
        "csharpier.csharpier-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[csharp]": {
          "editor.defaultFormatter": "csharpier.csharpier-vscode"
        },
        "[vue]": {
          "editor.defaultFormatter": "vue.volar"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "dotnet.defaultSolution": "/workspaces/csb-exhibit-submissions/api/CES.API/CES.API.sln"
      }
    }
  },
  "remoteUser": "root",
  "containerEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "forwardPorts": [5173, 5285, 7090, 5432],
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
