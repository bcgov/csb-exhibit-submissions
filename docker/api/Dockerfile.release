# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy all source code
COPY api/ ./api/

# Build and publish
WORKDIR /src/api/CES.API
RUN dotnet publish -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# Npgsql requires GSSAPI (Kerberos) support, not present by default on Alpine
RUN apk add --no-cache krb5-libs

# Copy published app
COPY --from=build /app/publish .

RUN mkdir -p /app/keys /keys /data \
	&& chgrp -R 0 /app/keys /keys /data \
	&& chmod -R g=u /app/keys /keys /data

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Expose port
EXPOSE 8080

# Run as non-root user
USER 1001

# Start the application
ENTRYPOINT ["dotnet", "CES.API.dll"]
