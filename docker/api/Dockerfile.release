# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files and restore dependencies
COPY api/CES.API/CES.API.csproj ./api/CES.API/
COPY api/CES.Business/CES.Business.csproj ./api/CES.Business/
COPY api/CES.EF/CES.EF.csproj ./api/CES.EF/
COPY api/CES.Entities/CES.Entities.csproj ./api/CES.Entities/
COPY api/jc-interface-client/jc-interface-client.csproj ./api/jc-interface-client/
RUN dotnet restore ./api/CES.API/CES.API.csproj

# Copy source code
COPY api/ ./api/

# Build and publish
WORKDIR /src/api/CES.API
RUN dotnet publish -c Release -o /app/publish --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Copy published app
COPY --from=build /app/publish .

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Expose port
EXPOSE 8080

# Run as non-root user
USER 1001

# Start the application
ENTRYPOINT ["dotnet", "CES.API.dll"]
