# Database Configuration
POSTGRESQL_DATABASE=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

# API Configuration
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development
DatabaseConnectionString=
APP_ENVIRONMENT=dev
API_URL=http://api:8080/api/
WEB_BASE_HREF=/
ENABLE_SWAGGER=false

# File Services Client
FileServicesClient__Username=
FileServicesClient__Password=
FileServicesClient__Url=

# Location Services Client
LocationServicesClient__Username=
LocationServicesClient__Password=
LocationServicesClient__Url=

# Request Configuration
Request__ApplicationCd=
Request__AgencyIdentifierId=
Request__PartId=

# Keycloak (leave Enabled=false for the mock dev login)
Keycloak__Enabled=false
Keycloak__Authority=
Keycloak__Client=
Keycloak__Secret=
Keycloak__RedirectUri=http://localhost:9080/auth/callback
# Leave BLANK until SSO registers this URI under the client's Valid Post Logout
# Redirect URIs. An unregistered value makes Keycloak abort the entire end-session
# request with "invalid redirect URI", leaving the SSO session alive so the user is
# silently signed straight back in. Blank = Keycloak shows its own logged-out page
# and the session genuinely ends.
Keycloak__PostLogoutRedirectUri=

# Frontend mock login. Flip to false in lockstep with Keycloak__Enabled=true above —
# the two sides are not cross-validated, and a half-flipped pair 401s on every call.
VITE_DEV_AUTH_BYPASS=true

# Data Protection key ring (encrypts the auth cookies)
DataProtection__KeyPath=/keys

# CORS Configuration
CORS_DOMAIN=http://localhost:9080

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=csb-exhibit-submissions

# Storage Configuration
FileStorage__LocalPath=
FileStorage__AcceptedPath=
FileStorage__PendingProvider=
FileStorage__AcceptedProvider=
FileStorage__MaxFileSize=

# SMB accepted store (spec/smb-file-storage.md).
# Pending uploads always stay on pod disk; only the accepted store can move to SMB, and
# only once FileStorage__AcceptedProvider=Smb. Leave that as Local until Stage 3 lands —
# the values below are still read by the Stage 1 diagnostic (GET /api/dev/smb/health).
#
# Reaching the dev file server requires the ministry VPN. Off VPN the hostname does not
# resolve at all; that is expected, not a config error.
FileStorage__Smb__Server=
# Share name only — no server, no sub-path. A "$" suffix (hidden share) is fine.
# Unknown? Leave it blank on the first run and read it out of steps.listShares.shares.
FileStorage__Smb__ShareName=
# AD domain for the service account. Unconfirmed: try IDIR, then PROVJUD, then blank
# (blank makes NTLM defer to the server's own domain). A wrong value shows up as
# login.status = STATUS_LOGON_FAILURE.
FileStorage__Smb__Domain=
FileStorage__Smb__Username=
# Never committed, never logged. In OpenShift this comes from a secret.
FileStorage__Smb__Password=
# Path inside the share, above {locationId}. Unknown? Leave it blank on the first run to
# list the share root, then decide from steps.listBasePath.entries.
FileStorage__Smb__BasePath=
# Stage 1 only: a small file under BasePath the health endpoint reads and hashes.
FileStorage__Smb__ProbeFile=
# Lets /api/dev/smb/health run outside Development. In Development it is always on.
FileStorage__Smb__DiagnosticsEnabled=

# Tunables — all have working defaults in docker-compose.yaml; set only to override.
# TransportType: DirectTcp (445) or NetBios (139).
FileStorage__Smb__TransportType=
# AuthenticationMethod: NTLMv2 | NTLMv1ExtendedSessionSecurity | NTLMv1. SMBLibrary is
# NTLM-only — there is no Kerberos option.
FileStorage__Smb__AuthenticationMethod=
FileStorage__Smb__BufferSize=
FileStorage__Smb__MaxConcurrentSessions=
FileStorage__Smb__ConnectTimeoutMs=
FileStorage__Smb__MaxRetryAttempts=
FileStorage__Smb__InitialRetryDelayMs=
FileStorage__Smb__VerifyAfterWrite=