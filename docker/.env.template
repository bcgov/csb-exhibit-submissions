# Database Configuration
POSTGRESQL_DATABASE=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

# API Configuration
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development
DatabaseConnectionString=
APP_ENVIRONMENT=dev
API_URL=http://api:8080/api/
WEB_BASE_HREF=/
ENABLE_SWAGGER=false

# File Services Client
FileServicesClient__Username=
FileServicesClient__Password=
FileServicesClient__Url=

# Location Services Client
LocationServicesClient__Username=
LocationServicesClient__Password=
LocationServicesClient__Url=

# Request Configuration
Request__ApplicationCd=
Request__AgencyIdentifierId=
Request__PartId=

# Keycloak (leave Enabled=false for the mock dev login)
Keycloak__Enabled=false
Keycloak__Authority=
Keycloak__Client=
Keycloak__Secret=
Keycloak__RedirectUri=http://localhost:9080/auth/callback
# Leave BLANK until SSO registers this URI under the client's Valid Post Logout
# Redirect URIs. An unregistered value makes Keycloak abort the entire end-session
# request with "invalid redirect URI", leaving the SSO session alive so the user is
# silently signed straight back in. Blank = Keycloak shows its own logged-out page
# and the session genuinely ends.
Keycloak__PostLogoutRedirectUri=

# Frontend mock login. Flip to false in lockstep with Keycloak__Enabled=true above —
# the two sides are not cross-validated, and a half-flipped pair 401s on every call.
VITE_DEV_AUTH_BYPASS=true

# Data Protection key ring (encrypts the auth cookies)
DataProtection__KeyPath=/keys

# CORS Configuration
CORS_DOMAIN=http://localhost:9080

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=csb-exhibit-submissions

# Storage Configuration
FileStorage__LocalPath=
FileStorage__AcceptedPath=
FileStorage__PendingProvider=
FileStorage__AcceptedProvider=
FileStorage__MaxFileSize=