# Database Configuration
POSTGRESQL_DATABASE=cesdb
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=postgres

# API Configuration
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development
DatabaseConnectionString="Host=db;Port=5432;Database=cesdb;Username=postgres;Password=postgres;"
APP_ENVIRONMENT=dev
API_URL=http://api:8080/api/
WEB_BASE_HREF=/

# CORS Configuration
CORS_DOMAIN=http://localhost:9080

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=csb-exhibit-submissions
