{
  "name": "ces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check check:scss \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:scss": "sass --load-path=node_modules --no-source-map src/styles/main.scss:/dev/null",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bcgov/bc-sans": "^2.1.0",
    "@bcgov/design-tokens": "^5.0.0",
    "@mdi/js": "^7.4.47",
    "axios": "^1.19.0",
    "bootstrap": "^5.3.8",
    "dropzone": "^6.0.0-beta.2",
    "jwt-decode": "^4.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.11"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.75.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.75.0",
    "prettier": "3.9.6",
    "sass-embedded": "^1.100.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "~6.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.8",
    "vite": "^8.1.5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.4",
    "nanoid": "^3.3.17",
    "vite-plugin-inspect": "^12.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  }
}
