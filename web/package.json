{
  "name": "ces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check check:scss \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:scss": "sass --load-path=node_modules --no-source-map src/styles/main.scss:/dev/null",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bcgov/bc-sans": "^2.1.0",
    "@bcgov/design-tokens": "^4.0.0",
    "@mdi/js": "^7.4.47",
    "axios": "^1.16.0",
    "bootstrap": "^5.3.8",
    "dropzone": "^6.0.0-beta.2",
    "jwt-decode": "^4.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vuetify": "^4.0.6"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.61.0",
    "eslint-plugin-vue": "~10.9.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.61.0",
    "prettier": "3.8.3",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  }
}
